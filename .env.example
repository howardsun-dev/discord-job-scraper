# Discord Bot
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-client-id-here
DISCORD_GUILD_ID=your-dev-server-id-here

# Scraper
SCRAPER_ENABLED=false
SCRAPER_SCHEDULE=0 */4 * * *
SCRAPER_MAX_PAGES=1
DEFAULT_KEYWORDS=software engineer
DEFAULT_LOCATION=remote
INDEED_BASE_URL=https://www.indeed.com
LINKEDIN_BASE_URL=https://www.linkedin.com/jobs
GLASSDOOR_BASE_URL=https://www.glassdoor.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobscraper
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscraper
